{
  "name": "spr",
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:sandbox": "wrangler pages dev dist --ip 0.0.0.0 --port 3001",
    "dev:d1": "wrangler pages dev dist --d1=spr-production --local --ip 0.0.0.0 --port 3001",
    "build": "vite build",
    "preview": "wrangler pages dev dist",
    "deploy": "npm run build && wrangler pages deploy dist",
    "deploy:prod": "npm run build && wrangler pages deploy dist --project-name spr",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "clean-port": "fuser -k 3001/tcp 2>/dev/null || true",
    "test": "curl http://localhost:3001",
    "db:migrate:local": "wrangler d1 migrations apply spr-production --local",
    "db:migrate:prod": "wrangler d1 migrations apply spr-production",
    "db:seed": "wrangler d1 execute spr-production --local --file=./seed.sql",
    "db:reset": "rm -rf .wrangler/state/v3/d1 && npm run db:migrate:local && npm run db:seed",
    "git:commit": "git add . && git commit -m"
  },
  "dependencies": {
    "hono": "^4.12.15"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.2.0",
    "@hono/vite-cloudflare-pages": "^0.4.3",
    "@hono/vite-dev-server": "^0.25.2",
    "vite": "^6.3.5",
    "wrangler": "^4.4.0"
  }
}
